#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
#
# Keeps luci-app-wban bans applied to every hostapd interface.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/wban

start_service() {
	local enabled

	config_load wban
	config_get_bool enabled settings enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/ucode "$PROG" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "wban"
}
